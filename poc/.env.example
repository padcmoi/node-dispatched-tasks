# Copy to .env if you want to override the docker-compose defaults.
# All defaults are baked into docker-compose.yml so this file is optional.

# === MariaDB ===
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=dispatched_tasks_poc
MARIADB_USER=app
MARIADB_PASSWORD=app

# === Tasks owner ===
DT_REDIS_NAMESPACE=dispatched-tasks-poc

# Optional: override the SQL table name used by the dispatched-tasks lib.
# Defaults to `dispatched_task` (snake_case) when unset.
# Useful when the host project follows a different table naming convention.
DT_TABLE_NAME=dispatched-task123
