{
  "name": "@naskot/node-dispatched-tasks",
  "version": "0.1.0",
  "description": "Persisted, weight-aware async task dispatcher for Node microservices (MariaDB + Redis hybrid, agnostic Express/NestJS).",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-dispatched-tasks.git"
  },
  "homepage": "https://github.com/padcmoi/node-dispatched-tasks",
  "bugs": {
    "url": "https://github.com/padcmoi/node-dispatched-tasks/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "ci": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "node",
    "typescript",
    "task-queue",
    "dispatcher",
    "microservices",
    "mariadb",
    "redis",
    "typeorm",
    "express",
    "nestjs"
  ],
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "typeorm": "^0.3.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "eslint": "^10.2.1",
    "ioredis": "^5.4.1",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4",
    "zod": "^3.23.8"
  }
}
