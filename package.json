{
  "name": "@naskot/node-dispatched-tasks",
  "version": "1.0.1",
  "description": "Lightweight Redis-backed delayed-task scheduler for Node microservices: weight-aware execution, integer auto-increment IDs, framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-dispatched-tasks.git"
  },
  "homepage": "https://github.com/padcmoi/node-dispatched-tasks",
  "bugs": {
    "url": "https://github.com/padcmoi/node-dispatched-tasks/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "ci": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "node",
    "typescript",
    "task-queue",
    "delayed-tasks",
    "scheduler",
    "redis",
    "ioredis",
    "weight",
    "microservices"
  ],
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^24.6.0",
    "eslint": "^10.2.1",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
